From 5f8f3d1ffc1723fb53b4cb1ed345d73bfd7b76fd Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 07:28:36 +0000
Subject: [PATCH] refactor(frontend): run searchEmoji as an ordered list of
 steps

---
 packages/frontend/src/utility/search-emoji.ts | 95 +++++++++----------
 1 file changed, 44 insertions(+), 51 deletions(-)

diff --git a/packages/frontend/src/utility/search-emoji.ts b/packages/frontend/src/utility/search-emoji.ts
index 7c3996f1fc..c115d5dc4e 100644
--- a/packages/frontend/src/utility/search-emoji.ts
+++ b/packages/frontend/src/utility/search-emoji.ts
@@ -19,56 +19,56 @@ type EmojiScore = { emoji: EmojiDef, score: number };
 const AUTOCOMPLETE_POPUP_SIZE = 6;
 const FUZZY_MIN_QUERY_LENGTH = 4;
 
-type RankedEmoji = EmojiScore & { dbIndex: number };
-type Prioritizer = (x: EmojiDef, query: string) => number | null;
+type SearchContext = { query: string; emojiDb: EmojiDef[]; max: number; matches: Map<string, EmojiScore> };
+type Step = (context: SearchContext) => void;
+type NameTest = (x: EmojiDef, query: string) => boolean;
 
 const originalNameOf = (x: EmojiDef) => x.aliasOf ?? x.name;
 const isAlias = (x: EmojiDef) => Boolean(x.aliasOf);
-const OWN_NAME_EXACT_PRIORITY = 3;
 
-class EmojiPrioritizer {
-	constructor(private prioritizers: Prioritizer[] = []) {}
-
-	addPriority(prioritizer: Prioritizer): EmojiPrioritizer {
-		return new EmojiPrioritizer([...this.prioritizers, prioritizer]);
-	}
+function setScore(bonus: number, isMatch: NameTest): Step {
+	return ({ query, emojiDb, max, matches }) => {
+		emojiDb.some(x => {
+			if (isMatch(x, query)) matches.set(originalNameOf(x), { emoji: x, score: query.length + bonus });
+			return matches.size === max;
+		});
+	};
+}
 
-	priorityOf(x: EmojiDef, query: string): number | null {
-		const priorities = this.prioritizers.map(prioritizer => prioritizer(x, query)).filter(priority => priority !== null);
-		return priorities.length > 0 ? query.length + Math.max(...priorities) : null;
-	}
+function setScoreIfNull(bonus: number, isMatch: NameTest): Step {
+	return context => setScore(bonus, (x, query) => isMatch(x, query) && !context.matches.has(originalNameOf(x)))(context);
 }
 
-const exactPrioritizer = new EmojiPrioritizer()
-	.addPriority((x, q) => {
-		if (x.name === q) return isAlias(x) ? 2 : OWN_NAME_EXACT_PRIORITY;
-		return null;
-	});
-
-const partialPrioritizer = exactPrioritizer
-	.addPriority((x, q) => {
-		if (x.name.startsWith(q)) return isAlias(x) ? 0 : 1;
-		return null;
-	})
-	.addPriority((x, q) => {
-		if (x.name.includes(q)) return -1;
-		return null;
-	});
-
-function rankByNameMatch(prioritizer: EmojiPrioritizer, query: string, emojiDb: EmojiDef[]): Map<string, EmojiScore> {
-	const bestPerEmoji = new Map<string, RankedEmoji>();
-	emojiDb.forEach((emoji, dbIndex) => {
-		const score = prioritizer.priorityOf(emoji, query);
-		if (score === null) return;
-		const best = bestPerEmoji.get(originalNameOf(emoji));
-		const replacesSameNamedEmoji = score === query.length + OWN_NAME_EXACT_PRIORITY;
-		if (!best || score > best.score || (score === best.score && replacesSameNamedEmoji)) {
-			bestPerEmoji.set(originalNameOf(emoji), { emoji, score, dbIndex });
+function addFuzzyHits(): Step {
+	return ({ query, emojiDb, matches }) => {
+		if (query.length < FUZZY_MIN_QUERY_LENGTH) return;
+		for (const hit of fuzzyHits(query, emojiDb, matches)) {
+			matches.set(hit.emoji.name, hit);
 		}
-	});
+	};
+}
 
-	const ranked = [...bestPerEmoji.entries()].sort(([, x], [, y]) => y.score - x.score || x.dbIndex - y.dbIndex);
-	return new Map(ranked);
+const exactSteps: Step[] = [
+	setScore(3, (x, q) => x.name === q && !isAlias(x)),
+	setScoreIfNull(2, (x, q) => x.name === q),
+];
+
+const partialSteps: Step[] = [
+	setScoreIfNull(1, (x, q) => x.name.startsWith(q) && !isAlias(x)),
+	setScoreIfNull(0, (x, q) => x.name.startsWith(q)),
+	setScoreIfNull(-1, (x, q) => x.name.includes(q)),
+];
+
+class EmojiScorer {
+	static run(steps: Step[], query: string, emojiDb: EmojiDef[], max: number): Map<string, EmojiScore> {
+		const context: SearchContext = { query, emojiDb, max, matches: new Map() };
+		for (const [i, step] of steps.entries()) {
+			const isFirstStep = i === 0;
+			if (!isFirstStep && context.matches.size >= max) break;
+			step(context);
+		}
+		return context.matches;
+	}
 }
 
 function topByScore(matched: Map<string, EmojiScore>, max: number): EmojiDef[] {
@@ -114,15 +114,8 @@ export function searchEmoji(query: string | null, emojiDb: EmojiDef[], max = 30)
 		return [];
 	}
 
-	const matched = rankByNameMatch(partialPrioritizer, query, emojiDb);
-
-	if (matched.size < max && query.length >= FUZZY_MIN_QUERY_LENGTH) {
-		for (const it of fuzzyHits(query, emojiDb, matched)) {
-			matched.set(it.emoji.name, it);
-		}
-	}
-
-	return topByScore(matched, max);
+	const matches = EmojiScorer.run([...exactSteps, ...partialSteps, addFuzzyHits()], query, emojiDb, max);
+	return topByScore(matches, max);
 }
 
 export function searchEmojiExact(query: string | null, emojiDb: EmojiDef[], max = 30): EmojiDef[] {
@@ -130,5 +123,5 @@ export function searchEmojiExact(query: string | null, emojiDb: EmojiDef[], max
 		return [];
 	}
 
-	return topByScore(rankByNameMatch(exactPrioritizer, query, emojiDb), max);
+	return topByScore(EmojiScorer.run(exactSteps, query, emojiDb, max), max);
 }
-- 
